# =============================================================
# AI Stock Intelligence Platform — Environment Configuration
# Copy to .env and fill in your credentials
# NEVER commit .env to version control
# =============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stockdb
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/stockdb

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Upstox API (Primary live data provider) ---
# Register at https://upstox.com/developer/
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_after_oauth

# --- Zerodha Kite API (Alternative) ---
# Register at https://kite.trade/
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=your_kite_access_token

# --- Data Source Selection ---
# Options: upstox | kite | yahoo_fallback
DATA_PROVIDER=yahoo_fallback

# --- Application Settings ---
APP_ENV=development
SECRET_KEY=change_this_to_a_long_random_secret_key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML Settings ---
MODEL_RETRAIN_INTERVAL_HOURS=24
SIGNAL_CONFIDENCE_THRESHOLD=0.60
RISK_REWARD_RATIO=2.0
ATR_MULTIPLIER_SL=1.5
ATR_MULTIPLIER_TP=3.0

# --- Data Freshness Thresholds (seconds) ---
LIVE_THRESHOLD_SECONDS=30
DELAYED_THRESHOLD_SECONDS=300

# --- NSE Market Hours (IST = UTC+5:30) ---
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# --- Logging ---
LOG_LEVEL=INFO
